__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# NOTE: verdicts/ is deliberately NOT ignored.
# Verdict files are evidence — the record of who checked what, and when.
# Only local scratch belongs in .gitignore.

# DeepFreeze protection facilities (D:\15812\projects\deepfreeze). A protect run
# writes a full snapshot tree here; without these lines `git add -A` stages the
# whole thing. These are local protection state, never repository content.
.freeze/
.freeze-snap/

# Reviewer scratch. A reviewing agent may add a git worktree under .agnes/ to get an
# isolated copy (needed to re-run a reversed-proof check without checking out an old
# commit in the live tree). A worktree contains its own .git and its own working
# files, so without this line `git status` reports the whole tree as untracked and
# `git add -A` would stage a second copy of the repository.
.agnes/

# Eval harness sealed materials (XJ-20261024-001). The two hidden negative-control
# variants (controls-sealed/) and the runtime blind seeds / condition maps /
# packages (.eval-sealed/) are sir's custody by design: committing them would
# end the blinding that the study's validity depends on. Unlike verdicts/
# (deliberately kept above), these MUST NOT be tracked.
tools/eval/tasks/controls-sealed/
.eval-sealed/

# Execution products stay out of git (round-4 leak via git add -A)
run-dir/
# Dry-run probes are session artifacts, never tracked
dryrun/

# Round-10 execution products (XJ-20261111-001 D0; card constraint L48).
# Not covered by the exact-name rules run-dir/ and dryrun/ above.
out/
run-dir-r10/
shadow-r10/

# Round-11 execution products (XJ-20261111-002 D0; card "其他纪律" L109).
# out/ already covered above; these two exact names are not.
run-dir-r11/
shadow-r11/
